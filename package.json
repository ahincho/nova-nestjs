{
  "name": "nova-nestjs",
  "version": "0.0.0",
  "private": true,
  "description": "Nova Platform meta-framework for NestJS",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahincho/nova-nestjs.git"
  },
  "type": "commonjs",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:cov": "pnpm -r run test:cov",
    "verify": "pnpm peers check && pnpm build && pnpm typecheck && pnpm test:cov && pnpm format:check",
    "clean": "pnpm -r run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "prettier": "^3.9.6",
    "typescript": "catalog:"
  }
}
