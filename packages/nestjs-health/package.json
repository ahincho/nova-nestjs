{
  "name": "@ahincho/nova-nestjs-health",
  "version": "0.1.0",
  "description": "Liveness and readiness probes for Nova Platform NestJS services, answering the shape a load balancer checks",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahincho/nova-nestjs.git",
    "directory": "packages/nestjs-health"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist coverage *.tsbuildinfo",
    "test": "jest",
    "test:cov": "jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ahincho/nova-nestjs-api-standard": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@ahincho/nova-jest-preset": "workspace:*",
    "@ahincho/nova-tsconfig": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "jest": "^30.4.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  }
}
