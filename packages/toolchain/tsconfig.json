{
  "extends": "./tsconfig/base.json",
  "compilerOptions": {
    // Este paquete no publica TypeScript: publica presets y el comando `nova`,
    // los tres en JavaScript. Aun asi se typechequea, por dos motivos. Uno, es
    // codigo que corre en cada consumidor. Dos, sin un tsconfig que lo cubra,
    // `oxlint --type-aware` no consigue tipos y sus reglas `no-unsafe-*` se
    // disparan sobre todo el archivo, que es ruido y no un hallazgo.
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": ["bin/**/*.mjs", "vitest/**/*.mjs", "vitest/**/*.d.mts"],
  "exclude": ["node_modules"]
}
