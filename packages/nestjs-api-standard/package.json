{
  "name": "@nova-platform/nestjs-api-standard",
  "version": "0.1.0",
  "description": "NestJS integration for the Nova Platform response envelope: global interceptor, exception filter and validation errors",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahincho/nova-nestjs.git",
    "directory": "packages/nestjs-api-standard"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist coverage *.tsbuildinfo",
    "test": "jest",
    "test:cov": "jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nova-platform/api-standard": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nova-platform/jest-preset": "workspace:*",
    "@nova-platform/tsconfig": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "jest": "^30.4.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  }
}
