{
  "name": "@ahincho/nova-nestjs",
  "version": "0.2.0",
  "description": "The Nova Platform meta-framework for NestJS: response envelope, configuration, HTTP client, request context and health probes, wired by one module and one bootstrap call",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahincho/nova-nestjs.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist coverage *.tsbuildinfo",
    "test": "jest",
    "test:cov": "jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "jest": "^30.4.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3",
    "@ahincho/nova-nestjs-toolchain": "workspace:*"
  }
}
