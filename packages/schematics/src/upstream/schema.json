{
  "$schema": "http://json-schema.org/schema",
  "$id": "NovaUpstream",
  "title": "Nova upstream",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del upstream, en kebab-case o camelCase",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "¿Cómo se llama el upstream?"
    },
    "path": {
      "type": "string",
      "description": "Dónde escribirlo. Por defecto src/upstream/<name>",
      "format": "path"
    }
  },
  "required": ["name"]
}
