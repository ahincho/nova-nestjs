{
  "$schema": "http://json-schema.org/schema",
  "$id": "NovaFeature",
  "title": "Nova feature",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del feature, en kebab-case o camelCase",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "¿Cómo se llama el feature?"
    },
    "style": {
      "type": "string",
      "description": "Layout a generar",
      "enum": ["acl", "bff"],
      "default": "acl",
      "x-prompt": {
        "message": "¿Qué layout?",
        "type": "list",
        "items": [
          { "value": "acl", "label": "acl - hexagonal completo, con domain/" },
          {
            "value": "bff",
            "label": "bff - adaptadores de salida en src/upstream/"
          }
        ]
      }
    },
    "path": {
      "type": "string",
      "description": "Dónde escribirlo",
      "format": "path"
    }
  },
  "required": ["name"]
}
